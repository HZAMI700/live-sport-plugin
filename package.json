{
  "name": "live-sport-plugin",
  "version": "1.0.0",
  "description": "The ultimate live sports streaming add-on for Nuvio/Stremio. Scrapes multiple high-speed providers with a zero-lag proxy.",
  "main": "dist/index.js",
  "scripts": {
    "build": "echo build",
    "bundle": "npx @vercel/ncc build src/index.js -o dist --minify && node scripts/copy-assets.js",
    "prestart": "node -e \"if (!require('fs').existsSync('dist/index.js')) { require('child_process').execSync('npm run bundle', {stdio:'inherit'}); }\"",
    "start": "node dist/index.js",
    "dev": "node --watch-path=src src/index.js",
    "test": "jest",
    "test:e2e-client": "node scripts/test-e2e-simulated-client.js",
    "test:sanity": "node scripts/test-e2e-simulated-client.js",
    "test:247": "node scripts/test-247-channels.js",
    "generate:provider": "node scripts/generate-provider.js",
    "check-sources": "node scripts/check-sources.js"
  },
  "dependencies": {
    "@vercel/ncc": "^0.45.0",
    "acorn": "^8.18.0",
    "awilix": "^13.0.5",
    "big-integer": "^1.6.52",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "curl-impersonate": "^0.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "got-scraping": "^4.2.1",
    "happy-dom": "^20.11.1",
    "http-proxy-middleware": "^4.2.0",
    "impit": "^0.14.3",
    "jest": "^30.4.2",
    "js-yaml": "^5.2.2",
    "jsdom": "^29.1.1",
    "lz-string": "^1.5.0",
    "m3u8-parser": "^7.2.0",
    "nock": "^14.0.16",
    "node-cron": "^4.6.0",
    "opossum": "^10.0.0",
    "stremio-addon-sdk": "^1.6.10",
    "undici": "^8.10.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "addon",
    "live-sports",
    "sports-streaming"
  ],
  "license": "MIT",
  "overrides": {
    "glob": "^11.0.0",
    "inflight": "^1.0.6"
  }
}