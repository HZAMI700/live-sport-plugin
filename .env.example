# Port the addon server will listen on (provided by host or defaults to 7000)
PORT=7000

# Base URL override (optional, e.g. https://yourdomain.com)
ADDON_URL=

# Host binding override (optional, default 0.0.0.0)
HOST=0.0.0.0

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=
